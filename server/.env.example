MONGO_URI = mongodb+srv://<user>:<password>@<cluster-url>/HMMS?retryWrites=true&w=majority
TOKEN_SECRECT = <random 256-bit hex string>
PORT = 5000
FRONTEND_URL = http://localhost:3000
NODE_ENV = development
SMTP_HOST = sandbox.smtp.mailtrap.io
SMTP_PORT = 2525
SMTP_USER = <mailtrap-or-provider-user>
SMTP_PASS = <mailtrap-or-provider-pass>
EMAIL_FROM = <sender-email-address>
